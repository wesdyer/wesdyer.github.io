*.swp
node_modules/
regatta/eval/eval_results.json
regatta/assets/.DS_Store
clear-for-action/useful/.DS_Store
.DS_Store
clear-for-action/useful/.DS_Store
clear-for-action/.DS_Store
.claude/settings.local.json
.claude/scheduled_tasks.lock
.obsidian/

# OpenAI batch scratch — request payloads and the in-flight batch id
regatta/art/batch_input.jsonl
regatta/art/.batch_state.json

# plant_cove.py's working directory: the cached distance-transform geometry (~1.4 MB,
# rebuilt in 9s whenever the coastline changes) and the field/zone diagnostic PNGs it
# writes under --maps. All regenerable, none of it input.
regatta/art/_cove_fields/

# Credentials — never commit. The OpenAI key belongs in the shell profile or in
# ~/.config/openai/regatta-key (outside the repo), never in a tracked file.
.env
.env.*
*.key
*-key
*_key
**/openai-key
**/secrets.json

# Portrait review scratch — contact sheets and the feedback file
regatta/art/review/

# Generated portrait candidates awaiting a review decision
regatta/art/candidates/

# RL training scratch — the frozen repo snapshot the benches run against, and run logs
regatta/eval/rl/treeA/
regatta/eval/rl/treeC/
regatta/eval/rl/treeD/
regatta/eval/rl/*.log
regatta/eval/rl/treeE/
regatta/eval/rl/treeF/
regatta/eval/rl/treeG/
regatta/eval/rl/treeH/
regatta/eval/rl/treeI/
regatta/eval/rl/treeJ/
regatta/eval/rl/treeK/
regatta/eval/rl/treeL/
regatta/eval/rl/treeM/
regatta/eval/rl/treeN/
regatta/eval/rl/treeO/
regatta/eval/rl/treeP/
regatta/eval/rl/treeQ/
regatta/eval/rl/treeR/
# Multi-character tree names (treeR1, treeM3, treeBase, ...). The single-letter list
# above predates them and a night's work adds a dozen full repo copies.
regatta/eval/rl/tree[A-Z]?*/

# Bench and probe OUTPUT under regatta/eval/rl — scratch by default. Files already
# tracked stay tracked (git does not ignore what it is already following), so the
# committed baselines and attributions are unaffected; this only stops the next
# session's hundred bench JSONs from showing up as untracked noise.
regatta/eval/rl/*.json

# Character re-rating campaign (regatta/eval/RATING.md). The race rows are large and
# fully reproducible — seeds are a pure function of (venue, shard) and the RNG is
# seeded per trial — so the tooling and the small metadata are tracked and the bulk
# output is not. rating-preAI/ IS tracked: it is the pre-merge AI at the same seeds,
# a paired experiment that cannot be regenerated without checking out the old tree.
regatta/eval/rating/*.jsonl
regatta/eval/rating/*.part
